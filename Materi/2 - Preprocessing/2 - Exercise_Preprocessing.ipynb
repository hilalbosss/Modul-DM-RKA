        "colors = ['r', 'g']\n",
        "\n",
        "for target, color in zip(targets, colors):\n",
        "    indices_to_keep = embedded_df_df['label'] == target\n",
        "    plt.scatter(embedded_df_df.loc[indices_to_keep, 'Component 1'],\n",
        "                embedded_df_df.loc[indices_to_keep, 'Component 2'],\n",
        "                c=color,\n",
        "                label=target,\n",
        "                alpha=0.7)\n",
        "\n",
        "plt.xlabel('Component 1')\n",
        "plt.ylabel('Component 2')\n",
        "plt.title('t-SNE: Nonlinear Dimensionality Reduction')\n",
        "plt.legend()\n",
        "plt.show()"
