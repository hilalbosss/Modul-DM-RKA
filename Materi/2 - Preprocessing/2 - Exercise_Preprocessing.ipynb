    "    \"Medali Emas\" : 3,\n",
    "    \"Juara 1\" : 3\n",
    "}\n",
    "\n",
    "cols_jenjang = [\"pres1_jenjang\", \"pres2_jenjang\", 'pres3_jenjang']\n",
    "cols_juara = [\"juara_pres1\", \"juara_pres2\", \"juara_pres3\",]\n",
    "\n",
    "for col in cols_jenjang:\n",
    "  df_merged[col] = df_merged[col].map(jenjang_mapping)\n",
    "\n",
    "for col in cols_juara:\n",
    "   df_merged[col] = df_merged[col].map(juara_mapping)\n",
    "\n",
    "# no achievement, fill with 0\n",
    "df_merged[cols_pres] = df_merged[cols_pres].fillna(0)\n",
    "\n",
    "\n",
    "df_merged.head()\n"
