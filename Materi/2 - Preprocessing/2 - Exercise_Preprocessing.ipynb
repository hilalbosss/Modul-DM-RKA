        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.feature_selection import SelectFromModel\n",
        "from sklearn.metrics import accuracy_score\n",
        "\n",
        "X = df_normalized.drop([\"id\",\"status_kelulusan\"], axis = 1)\n",
        "y = df_normalized[\"status_kelulusan\"]\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=123)\n",
        "\n",
        "X_train.shape, X_test.shape"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 224,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "3EbU6iMjOyBp",
        "outputId": "c9e4e59f-dbaa-43a0-cb95-9b17be926c9f"
      },
      "outputs": [
        {
          "data": {
            "text/plain": [
              "((14764, 30), (3692, 30))"
            ]
          },
          "execution_count": 224,
          "metadata": {},
          "output_type": "execute_result"
        }
      ],
      "source": [
        "clf = RandomForestClassifier(random_state=123)\n",
        "clf.fit(X_train, y_train)\n",
        "\n",
        "sfm = SelectFromModel(clf, threshold=0.02)\n",
        "sfm.fit(X_train, y_train)\n",
        "\n",
        "X_train_selected = sfm.transform(X_train)\n",
        "X_test_selected = sfm.transform(X_test)\n",
        "X_train_selected.shape, X_test_selected.shape"
      ]
    },
